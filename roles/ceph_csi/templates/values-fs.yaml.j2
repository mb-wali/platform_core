# https://github.com/ceph/ceph-csi/blob/release-v3.15/charts/ceph-csi-cephfs/values.yaml
## helm upgrade --install --namespace  ceph-csi-cephfs ceph-csi-cephfs --version 3.15.0 ceph-csi-cephfs/ceph-csi-cephfs -f cephfs.yaml

csiConfig:
  - clusterID: "{{ ceph_csi_cluster_id }}" # "<your-ceph-cluster-id>"
    monitors:
      - "{{ ceph_csi_subnet }}.154:6789"
      - "{{ ceph_csi_subnet }}.155:6789"
      - "{{ ceph_csi_subnet }}.156:6789"

    cephFS:
      subvolumeGroup: "{{ ceph_csi_fs_subvolumegroup_name }}"
      radosNamespace: "csi"

storageClass:
  create: true
  name: ceph-fs
  fsName: cephfs_kube
  clusterID: "{{ ceph_csi_cluster_id }}" #"<your-ceph-cluster-id>"
  pool: ""
  provisionerSecret: csi-cephfs-secret
  nodeStageSecret: csi-cephfs-secret
  controllerExpandSecret: csi-cephfs-secret

  # namespace where secrets are located
  provisionerSecretNamespace: "ceph-csi-cephfs"
  controllerExpandSecretNamespace: "ceph-csi-cephfs"
  nodeStageSecretNamespace: "ceph-csi-cephfs"

  reclaimPolicy: Retain # for now testing..
  allowVolumeExpansion: true

# this secret is created by default in namespace "ceph-csi-rbd"
secret:
  create: true
  name: csi-cephfs-secret
  adminID: "{{ ceph_csi_fs_user_id }}"
  adminKey: "{{ ceph_csi_fs_user_key }}"
  userID: "{{ ceph_csi_fs_user_id }}" # "<ceph-user>"         # e.g. client.kube   - without the client.
  userKey: "{{ ceph_csi_fs_user_key }}" # "<ceph-user-key>"    # ceph auth get-key client.kube

cephconf: |
  [global]
    auth_cluster_required = cephx
    auth_service_required = cephx
    auth_client_required = cephx

    # ceph-fuse which uses libfuse2 by default has write buffer size of 2KiB
    # adding 'fuse_big_writes = true' option by default to override this limit
    # see https://github.com/ceph/ceph-csi/issues/1928
    fuse_big_writes = true

readAffinity:
  # Recommended to set to true if running kernel 5.8 or newer.
  enabled: true

provisioner:
  replicaCount: {{ ceph_csi_fs_provisioner_replica }}
  provisioner:
    args:
      httpEndpointPort: 8090
  resizer:
    args:
      httpEndpointPort: 8091
  snapshotter:
      args:
        httpEndpointPort: 8092

encryptionKMSConfig:
  encryptionKMSType: ""
