# https://github.com/prometheus-community/helm-charts/blob/main/charts/kube-prometheus-stack/values.yaml
# using kube-prometheus-stack

# kubectl create namespace monitoring
# helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
# helm repo update
# helm upgrade --install --namespace monitoring kube-prometheus-stack --version 79.0.1 prometheus-community/kube-prometheus-stack --create-namespace -f values/kube-prometheus-stack/values.yaml

grafana:
  enabled: true
  env:
    GRAFANA_OIDC_CLIENT_SECRET: "{{ grafana_oauth_client_secret }}"
  persistence:
    enabled: true
    # type: sts
    # storageClassName: "ceph-rbd"
    accessModes:
      - ReadWriteOnce
    size: 20Gi
    # finalizers:
    #   - kubernetes.io/pvc-protection

  # built in dahboards
  defaultDashboardsEnabled: true

  grafana.ini:
    smtp: # https://grafana.com/docs/grafana/latest/setup-grafana/configure-grafana/#smtp
      enabled: {{ grafana_smtp_enable }}
      host: {{ grafana_smtp_host }}
      from_address: noreply@{{ grafana_domain_url }}
      from_name: Grafana
    # plugins:
    #   plugin_admin_enabled: true
    #   plugin_admin_external_manage_enabled: true
    server:
      domain: {{ grafana_domain_url }}
      root_url: https://{{ grafana_domain_url }}
      # serve_from_sub_path: true
    auth:
      disable_login_form: true
      disable_signout_menu: false
      oauth_auto_login: true
    auth.basic:
      enabled: false
    auth.generic_oauth:
      client_secret: "${GRAFANA_OIDC_CLIENT_SECRET}"
      allowed_groups: "{{ grafana_oauth_allowed_groups }}"
      groups_attribute_path: groups
      enabled: true
      name: "Keycloak"
      allow_sign_up: true
      client_id: "grafana"
      scopes: "openid profile email"
      auth_url: "{{ grafana_oauth_realm_url }}/protocol/openid-connect/auth"
      token_url: "{{ grafana_oauth_realm_url }}/protocol/openid-connect/token"
      api_url: "{{ grafana_oauth_realm_url }}/protocol/openid-connect/userinfo"
      role_attribute_path: {{ grafana_oauth_roles }}
      email_attribute_name: "email"
      login_attribute_path: "preferred_username"
      name_attribute_path: "name"
      signout_redirect_url: {{ grafana_oauth_realm_url }}/protocol/openid-connect/logout?post_logout_redirect_uri=https%3A%2F%2F{{ grafana_domain_url }}%2Flogin

  ingress:
    enabled: true
    ingressClassName: {{ clusterIngressClassName }}
    hosts:
      - {{ grafana_domain_url }}
    path: /
    pathType: Prefix
    extraPaths: []
    tls: []


prometheus:
  enabled: true
  ingress:
    enabled: {{ prometheus_ingress_enable }}
    ingressClassName: "{{ clusterIngressClassName }}"
    hosts:
      - {{ prometheus_domain_url }}
    path: /
    pathType: Prefix
    tls: []

  prometheusSpec:
    ## AdditionalScrapeConfigs allows specifying additional Prometheus scrape configurations.
    additionalScrapeConfigs: []

    ## enable --web.enable-remote-write-receiver flag on prometheus-server
    ##
    ## okay to enable for small tests - but recommanded: k6 → VictoriaMetrics / Mimir → Grafana
    enableRemoteWriteReceiver: {{ prometheus_remote_write }}
