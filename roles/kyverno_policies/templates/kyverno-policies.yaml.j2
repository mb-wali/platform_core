# https://github.com/kyverno/kyverno/blob/main/charts/kyverno-policies/values.yaml
# https://artifacthub.io/packages/helm/kyverno/kyverno-policies

# -- Pod Security Standard profile (`baseline`, `restricted`, `privileged`, `custom`).
# For more info https://kyverno.io/policies/pod-security.
podSecurityStandard: {{ kyverno_podSecurityStandard }}

# -- Validation failure action (`Audit`, `Enforce`).
# For more info https://kyverno.io/docs/policy-types/cluster-policy/validate.
validationFailureAction: {{ kyverno_validationFailureAction }}

# -- Policy engine type (`ClusterPolicy`, `ValidatingPolicy`)
#
# `ValidatingPolicy` installs CEL-based policies using the
# policies.kyverno.io API.
#
# `ClusterPolicy` is the legacy kyverno.io policy type.
policyType: ValidatingPolicy


# ---------------------------------------------------------------------------
# Global ValidatingPolicy exclusions
# ---------------------------------------------------------------------------
#
# These namespaces completely ignore ALL ValidatingPolicy policies.
#
{% if kyverno_policy_excludeNamespaces %}
vpolExclude:
  excludeNamespaces:
{% for namespace in kyverno_policy_excludeNamespaces %}
    - {{ namespace }}
{% endfor %}
{% endif %}

# ---------------------------------------------------------------------------
# Per-policy ValidatingPolicy exclusions
# ---------------------------------------------------------------------------
#
# Optional.
#
# Use this when a namespace should ignore ONLY specific policies instead of
# all ValidatingPolicy policies.
#
# NOTE:
# `vpolExcludeByPolicy` overrides the global `vpolExclude` configuration
# for the specified policy. It does NOT simply add to the global list.
#
# Therefore, when using it, the global exclusions need to be included again
# for that policy if they should remain excluded.
#
# Example:
#
# vpolExcludeByPolicy:
#   disallow-capabilities-strict:
#     excludeNamespaces:
#       - kube-system
#       - cert-manager
#       - argocd
#
#   restrict-seccomp-strict:
#     excludeNamespaces:
#       - kube-system
#       - cert-manager
#       - argocd
#       - gitlab-runner
#
# Currently disabled because `argocd` and `vault` are globally excluded
# above and therefore already ignore all policies.
#
# vpolExcludeByPolicy:
#   disallow-capabilities-strict:
#     excludeNamespaces:
#       # Add global exclusions here as needed.
#       # - kube-system
#       # - cert-manager
#
#       # Policy-specific exclusions:
#       # - argocd
#       # - vault
#
#   restrict-seccomp-strict:
#     excludeNamespaces:
#       # Add global exclusions here as needed.
#       # - kube-system
#       # - cert-manager
#
#       # Policy-specific exclusions:
#       # - argocd
#       # - vault
#       # - gitlab-runner
