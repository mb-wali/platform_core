# https://github.com/argoproj/argo-helm/blob/main/charts/argo-cd/values.yaml

global:
  domain: {{ argocd_hostname }}
  image:
    tag: "{{ argocd_version }}"
server:
  ingress:
    enabled: true
    ingressClassName: "{{ clusterIngressClassName }}"
    hostname: "{{ argocd_hostname }}" 
    path: /
    pathType: Prefix
    tls: false
  service:
    type: ClusterIP
    servicePortHttp: 80
    # -- Server service https port
    servicePortHttps: 443
    # -- Server service http port name, can be used to route traffic via istio
    servicePortHttpName: http
    # -- Server service https port name, can be used to route traffic via istio
    servicePortHttpsName: https
configs:
  # # Pulling OCI image from pull from private repo
  # # https://argo-cd.readthedocs.io/en/stable/operator-manual/declarative-setup/
  # repositories:
  #   harbor-internal-registry:
  #     url: {{ argocd_repo_helm_url }}
  #     type: helm
  #     enableOCI: "true"
  #     username: {{ argocd_extern_registry_username }}
  #     password: {{ argocd_extern_registry_password }}

  params:
    server.insecure: true

  cm:
    # disable basic argocd auth
    admin.enabled: false

    # Healthy ingress if lb IP is missing...
    resource.customizations.health.networking.k8s.io_Ingress: |
      hs = {}
      if obj.status ~= nil then
        -- Ingress is still pending or does not have an address
        if obj.status.loadBalancer == nil then
          hs.status = "Healthy"
          hs.message = "Ingress is still being provisioned, but will be considered healthy"
          return hs
        end
      end
      hs.status = "Healthy"
      hs.message = "Ingress is healthy"
      return hs

    # OIDC config
    oidc.config: |
      name: Keycloak
      issuer: {{ argocd_oidc_issuer }}
      clientID: {{ argocd_oidc_client }}
      clientSecret: {{ argocd_oidc_clientSecret }}
      requestedIDTokenClaims:
        groups:
          essential: true
      requestedScopes:
        - openid
        - profile
        - email
  rbac:
    create: true
    policy.default: role:unauthenticated
    policy.csv: |
      # https://github.com/argoproj/argo-cd/blob/master/assets/builtin-policy.csv
      g, {{ argocd_admin_role }}, role:admin
      
      # for readonly we will have a new group
      # g, everyone, role:readonly

      g, {{ argocd_dev_role }}, role:project-admins

      # # Full permissions to manage applications and projects
      # p, role:project-admins, applications, *, *, allow

      p, role:project-admins, applications, get, *, allow
      p, role:project-admins, applications, create, *, allow
      p, role:project-admins, applications, update, *, allow

      # allow specific application in a project delete.
      p, role:project-admins, applications, delete/*, {{ argocd_allow_pod_deletion_application }}, allow
      p, role:project-admins, applications, delete/*/PersistentVolumeClaim/*/*, {{ argocd_allow_pod_deletion_application }}, deny

      # p, role:project-admins, projects, *, *, allow
      p, role:project-admins, projects, get, *, allow

      # Full permissions to manage repositories
      p, role:project-admins, repositories, get, *, allow

      # Full permissions to manage clusters (destinations for applications)
      p, role:project-admins, clusters, get, *, allow
 
      # allow logs to view
      p, role:project-admins, logs, get, *, allow

      # Restrict access to the "default" project
      p, role:project-admins, projects, get, default, allow
      p, role:project-admins, projects, *, default, deny


      ### inveniordm
      # Group → roles
      g, {{ argocd_inveniordm_role }}, role:inveniordm-devs
      g, {{ argocd_inveniordm_role }}, proj:inveniordm:devs

      # GLOBAL RBAC (UI visibility)
      p, role:inveniordm-devs, clusters, get, *, allow
      p, role:inveniordm-devs, repositories, get, *, allow


      ### lcalyze
      # Group → roles
      g, {{ argocd_lcalyze_role }}, role:lcalyze-devs
      g, {{ argocd_lcalyze_role }}, proj:lcalyze:devs

      # GLOBAL RBAC (UI visibility)
      p, role:lcalyze-devs, clusters, get, *, allow
      p, role:lcalyze-devs, repositories, get, *, allow

      ### damap
      # Group → roles
      g, {{ argocd_dmp_role }}, role:dmp-devs
      g, {{ argocd_dmp_role }}, proj:dmp:devs

      # GLOBAL RBAC (UI visibility)
      p, role:dmp-devs, clusters, get, *, allow
      p, role:dmp-devs, repositories, get, *, allow

      ### elabftw
      # Group → roles
      g, {{ argocd_elabftw_role }}, role:elabftw-devs
      g, {{ argocd_elabftw_role }}, proj:elabftw:devs

      # GLOBAL RBAC (UI visibility)
      p, role:elabftw-devs, clusters, get, *, allow
      p, role:elabftw-devs, repositories, get, *, allow

      ### developers

      {% for dev in developers %}

      # ================================
      # {{ dev.name }}  - developer name
      # ================================

      # SSO / group binding → Argo role
      g, {{ dev.email }}, role:{{ dev.role }}
      g, {{ dev.email }}, proj:{{ dev.project }}:developer

      # Global UI visibility
      p, role:{{ dev.role }}, clusters, get, *, allow
      p, role:{{ dev.role }}, repositories, get, *, allow

      {% endfor %}

      ### projects roles

      {% for project in projects %}

      # ===================================
      # {{ project.name }}  - project name
      # ===================================

      # SSO / group binding → Argo role
      g, {{ project.role }}, role:{{ project.role }}
      g, {{ project.role }}, proj:{{ project.role }}:devs
     
      # Global UI visibility
      p, role:{{ project.role }}, clusters, get, *, allow
      p, role:{{ project.role }}, repositories, get, *, allow

      {% endfor %}

    # -- OIDC scopes to examine during rbac enforcement (in addition to `sub` scope).
    # The scope value can be a string, or a list of strings.
    scopes: "{{ argocd_oidc_scopes }}"

##################################
##### ArgoCD Vault Plugin (ACVP)#
##################################
repoServer:
  automountServiceAccountToken: true
  initContainers:
    - name: download-tools
      image: registry.access.redhat.com/ubi8
      env:
        - name: AVP_VERSION
          value: "{{ argocd_avp_version }}"
      command: [sh, -c]
      args:
        - >-
          curl -L https://github.com/argoproj-labs/argocd-vault-plugin/releases/download/v$(AVP_VERSION)/argocd-vault-plugin_$(AVP_VERSION)_linux_amd64 -o argocd-vault-plugin &&
          chmod +x argocd-vault-plugin &&
          mv argocd-vault-plugin /custom-tools/
      volumeMounts:
        - name: custom-tools
          mountPath: /custom-tools

  extraContainers:
    - name: avp-kustomize
      command: [/var/run/argocd/argocd-cmp-server]
      image: quay.io/argoproj/argocd:{{ argocd_version }}
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
      envFrom:
        - secretRef:
            name: argocd-vault-plugin-credentials
      volumeMounts:
        - name: var-files
          mountPath: /var/run/argocd
        - name: plugins
          mountPath: /home/argocd/cmp-server/plugins
        - name: cmp-tmp
          mountPath: /tmp
        - name: cmp-plugin
          mountPath: /home/argocd/cmp-server/config/plugin.yaml
          subPath: avp-kustomize.yaml
        - name: custom-tools
          mountPath: /usr/local/bin/argocd-vault-plugin
          subPath: argocd-vault-plugin

    - name: avp
      command: [/var/run/argocd/argocd-cmp-server]
      image: quay.io/argoproj/argocd:{{ argocd_version }}
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
      envFrom:
        - secretRef:
            name: argocd-vault-plugin-credentials
      volumeMounts:
        - name: var-files
          mountPath: /var/run/argocd
        - name: plugins
          mountPath: /home/argocd/cmp-server/plugins
        - name: cmp-tmp
          mountPath: /tmp
        - name: cmp-plugin
          mountPath: /home/argocd/cmp-server/config/plugin.yaml
          subPath: avp.yaml
        - name: custom-tools
          mountPath: /usr/local/bin/argocd-vault-plugin
          subPath: argocd-vault-plugin

    - name: avp-helm-inline-values
      command: [/var/run/argocd/argocd-cmp-server]
      image: quay.io/argoproj/argocd:{{ argocd_version }}
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
      envFrom:
        - secretRef:
            name: argocd-vault-plugin-credentials
      volumeMounts:
        - name: var-files
          mountPath: /var/run/argocd
        - name: plugins
          mountPath: /home/argocd/cmp-server/plugins
        - name: cmp-tmp
          mountPath: /tmp
        - name: cmp-plugin
          mountPath: /home/argocd/cmp-server/config/plugin.yaml
          subPath: avp-helm-inline-values.yaml
        - name: custom-tools
          mountPath: /usr/local/bin/argocd-vault-plugin
          subPath: argocd-vault-plugin

    - name: avp-helm-files
      command: [/var/run/argocd/argocd-cmp-server]
      image: {{ argocd_avp_image }}:{{ argocd_version }}
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
      envFrom:
        - secretRef:
            name: argocd-vault-plugin-credentials
      env:
        - name: GITHUB_APP_PRIVATE_KEY
          valueFrom:
            secretKeyRef:
              name: {{ argocd_github_app_secret }}
              key: githubAppPrivateKey
        - name: GITHUB_INSTALLATION_ID
          valueFrom:
            secretKeyRef:
              name: {{ argocd_github_app_secret }}
              key: githubAppInstallationID
        - name: GITHUB_APP_ID
          valueFrom:
            secretKeyRef:
              name: {{ argocd_github_app_secret }}
              key: githubAppID
      volumeMounts:
        - name: var-files
          mountPath: /var/run/argocd
        - name: plugins
          mountPath: /home/argocd/cmp-server/plugins
        - name: cmp-tmp
          mountPath: /tmp
        - name: cmp-plugin
          mountPath: /home/argocd/cmp-server/config/plugin.yaml
          subPath: avp-helm-files.yaml
        - name: custom-tools
          mountPath: /usr/local/bin/argocd-vault-plugin
          subPath: argocd-vault-plugin

  volumes:
    - name: custom-tools
      emptyDir: {}
    - name: cmp-plugin
      configMap:
        name: cmp-plugin
    - name: cmp-tmp
      emptyDir: {}
