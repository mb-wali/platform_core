############################################################
#################### Applications ##########################

applications:

  cloudnative-pg:
    project: databases

    sources:

      # Source 1: CloudNativePG Operator (default chart values)
      - repoURL: https://cloudnative-pg.github.io/charts
        chart: cloudnative-pg
        targetRevision: "0.29.1"
        helm:
          releaseName: cloudnative-pg
          namespace: postgresql

      # Source 2: PostgreSQL Cluster – values loaded through AVP Helm Files
      - repoURL: https://cloudnative-pg.github.io/charts
        chart: cluster
        targetRevision: "0.9.0"
        plugin:
          name: argocd-vault-plugin-helm-files
          env:
            - name: HELM_VALUES_REPO
              value: https://github.com/tugraz-rdm/argocd-deployments
            - name: HELM_VALUES_DIR
              value: helm/pg-cluster/qa
            - name: HELM_VALUES_BRANCH
              value: postgres

      # Source 3: extra-manifests
      - repoURL: https://github.com/tugraz-rdm/argocd-deployments.git
        path: helm/pg-cluster/qa/extra-manifests
        targetRevision: postgres
        
    destination:
      server: https://kubernetes.default.svc
      namespace: postgresql

    syncPolicy:
      automated:
        prune: true
        selfHeal: true
        enabled: true

      syncOptions:
        - CreateNamespace=true
        - SkipDryRunOnMissingResource=true

    revisionHistoryLimit: 3
