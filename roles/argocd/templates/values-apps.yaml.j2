    #       - p, proj:k6:devs, applications, sync, k6/*, allow

    #       # Find a better way to only allow deleting pods eg
    #       - p, proj:k6:devs, applications, delete/*, k6/*, allow
    #       # # Optional (commonly useful for devs)
    #       # - p, proj:k6:devs, applications, delete, k6/*, allow

    #       # Logs
    #       - p, proj:k6:devs, logs, get, k6/*, allow


    #     groups:
